{
  "name": "domain-blueprint",
  "version": "0.1.0",
  "description": "Generate and view domain/ER/flow/screen/API diagrams from a single model JSON.",
  "type": "module",
  "license": "MIT",
  "files": [
    "src",
    "template"
  ],
  "scripts": {
    "generate": "node src/cli.ts generate --config template/domain-blueprint.config.json",
    "build": "node src/cli.ts build --config template/domain-blueprint.config.json",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.9.3"
  }
}
